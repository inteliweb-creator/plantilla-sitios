# Variables del sitio. En local van en .env; en producción, en Vercel
# (Settings → Environment Variables). Nunca se suben al repositorio.

# Clave larga y aleatoria que protege las sesiones del panel. Una distinta por sitio.
PAYLOAD_SECRET=

# Dirección pública del sitio, sin barra al final. Ej: https://www.minegocio.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Base de datos
#   Local:       DATABASE_URL=file:./mi-sitio.db
#   Producción:  Turso. DATABASE_URL=libsql://…turso.io y DATABASE_AUTH_TOKEN=…
#   (si se conecta Turso desde Vercel, crea TURSO_DATABASE_URL y TURSO_AUTH_TOKEN, que también sirven)
DATABASE_URL=file:./mi-sitio.db
DATABASE_AUTH_TOKEN=

# Imágenes en la nube (Vercel Blob). Vercel la crea sola al conectar un Blob al proyecto.
BLOB_READ_WRITE_TOKEN=

# Correos (Resend): avisos de mensajes, boletín, recursos y recuperar contraseña.
RESEND_API_KEY=

# Vista previa de borradores
PREVIEW_SECRET=

# Pagos con Wompi (solo si la tienda está encendida). Pruebas: pub_test_ / test_integrity_ / test_events_
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
